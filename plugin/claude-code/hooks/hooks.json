{
  "description": "Pairwise 会话接入: 注入会话身份, 拦截直接编辑 .pair/, 回合结束前核对反馈闭环与文档同步, 会话结束时释放绑定",
  "hooks": {
    "SessionStart": [
      { "hooks": [{ "type": "command", "command": "pair hook session-start", "timeout": 30 }] }
    ],
    "CwdChanged": [
      { "hooks": [{ "type": "command", "command": "pair hook session-start", "timeout": 30 }] }
    ],
    "UserPromptSubmit": [
      { "hooks": [{ "type": "command", "command": "pair hook prompt-submit", "timeout": 30 }] }
    ],
    "PreToolUse": [
      { "hooks": [{ "type": "command", "command": "pair hook before-tool", "timeout": 30 }] }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [{ "type": "command", "command": "pair hook after-tool", "timeout": 30 }]
      }
    ],
    "Stop": [
      { "hooks": [{ "type": "command", "command": "pair hook before-stop", "timeout": 30 }] }
    ],
    "SessionEnd": [
      { "hooks": [{ "type": "command", "command": "pair hook session-end", "timeout": 30 }] }
    ]
  }
}
