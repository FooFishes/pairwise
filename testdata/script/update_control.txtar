scope:
  - "src/discover/**"
sections:
  tabs:
    assumptions:
      - id: no-mealtime
        text: "非推荐排序不传饭点参数"
      - id: keep-tab
        text: "返回页面时保留所选分类"
    retracted:
      - id: shared-sort
        text: "三个分类共用同一排序状态"
  stage:
    confirmed_hash: "388e36cc4281"
